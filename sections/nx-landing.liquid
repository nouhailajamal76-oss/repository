const SHORT=["Janv","Févr","Mars","Avr","Mai","Juin","Juil","Août","Sept","Oct","Nov","Déc"];
const pick={s1:0,s2:4};let view="stone";
function showThumb(btn){view=btn.dataset.src;document.querySelectorAll("#thumbs button").forEach(b=>b.setAttribute("aria-pressed",b===btn));const mi=document.getElementById("mainImg");if(view==="stone"){mi.className="";render()}else{mi.src=view;mi.className=btn.dataset.fit==="contain"?"":"cover"}document.getElementById("tag").hidden=view!=="stone";document.getElementById("gnote").hidden=view!==IMG["mere-fille"]}
function grid(id){const el=document.getElementById(id);el.innerHTML=`<img alt=""><select aria-label="${id==="s1"?"Pierre du collier 1":"Pierre du collier 2 (offert)"}">${STONES.map(([m,n],i)=>`<option value="${i}">${m} · ${n}</option>`).join("")}</select>`;el.querySelector("select").onchange=e=>{pick[id]=+e.target.value;if(id==="s1")showThumb(document.querySelector('#thumbs button[data-src="stone"]'));render()}}
function render(){
  ["s1","s2"].forEach(id=>{const el=document.getElementById(id);el.querySelector("select").value=pick[id];el.querySelector("img").src=IMG["stone-"+String(pick[id]+1).padStart(2,"0")]});
  const[m,n,c]=STONES[pick.s1];const src=IMG["stone-"+String(pick.s1+1).padStart(2,"0")];document.getElementById("thumbStone").src=src;if(view==="stone"){const mi=document.getElementById("mainImg");mi.src=src;mi.className="";}document.getElementById("tag").textContent=m+" · "+n;
  const two=document.getElementById("o2").checked;const s1=document.getElementById("s1"),host=document.getElementById(two?"b2":"b1");if(s1.parentNode!==host)host.prepend(s1);["second","was"].forEach(x=>document.getElementById(x).hidden=!two);
}
grid("s1");grid("s2");
document.getElementById("months").innerHTML=STONES.map(([m,n,c],i)=>`<div class="m"><img src="${IMG["stone-"+String(i+1).padStart(2,"0")]}" alt="Collier ${n}" loading="lazy"><b>${m}</b><span>${n}</span></div>`).join("");
document.querySelectorAll("#thumbs button").forEach(b=>b.onclick=()=>showThumb(b));
document.querySelectorAll('input[name="offer"]').forEach(r=>r.onchange=render);
document.getElementById("buy").addEventListener("submit",async e=>{e.preventDefault();const btn=document.getElementById("add"),m=document.getElementById("msg");if(!VARIANTS.length){m.textContent="Produit introuvable : choisis le produit dans les réglages de la section.";m.hidden=false;return}btn.disabled=true;const two=document.getElementById("o2").checked;const props=two?{"Collier offert – pierre":STONES[pick.s2][0]+" · "+STONES[pick.s2][1]}:{};try{const r=await fetch((window.Shopify&&Shopify.routes?Shopify.routes.root:"/")+"cart/add.js",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({items:[{id:VARIANTS[pick.s1],quantity:1,properties:props}]})});if(!r.ok)throw new Error();location.href="/checkout"}catch(_){btn.disabled=false;m.textContent="Oups, une erreur est survenue. Réessaie dans un instant.";m.hidden=false}});

render();
</script>
{% schema %}
{
  "name": "NX - Page Nexora",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit vendu (12 pierres, dans l'ordre Janvier → Décembre)" }
  ],
  "presets": [ { "name": "NX - Page Nexora" } ]
}
{% endschema %}
