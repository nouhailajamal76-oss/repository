{%- comment -%}Page Nexora reprise telle quelle de la maquette ; photos dans assets/nx-*.webp{%- endcomment -%}
{%- assign nx_product = section.settings.product -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=Karla:wght@400;500;700&display=swap">
<style>
/* Layout: Produktseite nach AIDA in 11 Abschnitten, ein einziger Kaufbutton in Abschnitt 6 */
:root{
  --bg:#eef1ef; --surface:#ffffff; --ink:#0e1411; --muted:#26302b; --line:#d3dbd7;
  --silver1:#f4f6f5; --silver2:#9aa6a1; --accent:#1f4a3d; --accent-ink:#ffffff;
  --deep:#162a24; --deep-ink:#e9f0ec; --flag:#fff3c4; --flag-ink:#6b5300; --star:#c9a227;
  --act:#c9a227; --act-ink:#1d1606; --red:#b3122b;
  --display:"Marcellus","Cormorant Garamond",Georgia,serif;
  --body:"Karla","Segoe UI",system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0f1714; --surface:#16211d; --ink:#e7eeea; --muted:#9db0a8; --line:#2a3833;
  --silver1:#e9eeec; --silver2:#7d8a85; --accent:#7fc4ab; --accent-ink:#0f1714;
  --deep:#0a120f; --deep-ink:#e7eeea; --flag:#3a3110; --flag-ink:#f3dc8a; --star:#e0bf4f; --act:#e0bf4f; --act-ink:#1d1606; --red:#ff6b6b; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0f1714; --surface:#16211d; --ink:#e7eeea; --muted:#9db0a8; --line:#2a3833;
  --silver1:#e9eeec; --silver2:#7d8a85; --accent:#7fc4ab; --accent-ink:#0f1714;
  --deep:#0a120f; --deep-ink:#e7eeea; --flag:#3a3110; --flag-ink:#f3dc8a; --star:#e0bf4f; --act:#e0bf4f; --act-ink:#1d1606; --red:#ff6b6b; color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.6}
.wrap{max-width:1080px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--display);font-weight:400;text-wrap:balance;line-height:1.2;margin:0}
h1{font-size:clamp(30px,5vw,48px)}
h2{font-size:clamp(24px,3.4vw,32px)}
h3{font-size:19px}
p{margin:0}
.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:12px;color:var(--muted);font-weight:700}
.head{display:flex;flex-direction:column;gap:8px;margin-bottom:28px;max-width:62ch}
.fill{background:var(--flag);color:var(--flag-ink);padding:0 4px;border-radius:2px}
section{padding-block:56px;border-top:1px solid var(--line)}

/* Kopfzeile */
.bar{background:var(--act);color:var(--act-ink);text-align:center;font-weight:700;font-size:14px;letter-spacing:.04em;padding-block:8px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header .wrap{display:flex;justify-content:space-between;align-items:center;padding-block:16px}
.logo{font-family:var(--display);font-size:26px;letter-spacing:.18em}
header small{color:var(--muted);font-size:13px}

/* 1 Hero */
.hero{background:var(--deep);color:var(--deep-ink);border-top:0;padding-block:0}
.hero .wrap{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.hero .wrap>*{min-width:0}
.hero p{color:color-mix(in srgb,var(--deep-ink) 78%,transparent);font-size:18px;max-width:46ch}
.hero .copy{display:flex;flex-direction:column;gap:16px}
.hstones{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:14px;color:color-mix(in srgb,var(--deep-ink) 78%,transparent)}
.hstones .heart{width:18px;height:16px}
.hstones span:last-child{margin-left:4px}
.hero .eyebrow{color:color-mix(in srgb,var(--deep-ink) 70%,transparent)}
.lifestyle{aspect-ratio:4/5;max-width:100%;border-radius:4px;background:radial-gradient(circle at 50% 35%,#3a5a50,#0e1c18 70%);display:grid;place-items:center;position:relative;overflow:hidden}
.lifestyle svg{width:60%;color:#8b1e2b}
.ph-label{position:absolute;left:12px;bottom:10px;font-size:12px;background:var(--flag);color:var(--flag-ink);padding:2px 6px;border-radius:2px}

/* 3 Vorteile */
.ben{display:grid;grid-template-columns:1fr minmax(0,320px) 1fr;gap:28px;align-items:center}
.ben>*{min-width:0}
.ben ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:28px}
.ben li{display:flex;gap:14px;align-items:flex-start}
.ben .r li{flex-direction:row}
.ico{flex:none;width:40px;height:40px;border-radius:50%;background:var(--surface);border:1px solid var(--line);display:grid;place-items:center;color:var(--accent)}
.ico svg{width:20px;height:20px}
.ben li b{display:block;font-size:16px}
.ben li span{color:var(--muted);font-size:15px}
.ben .center{background:var(--surface);border:1px solid var(--line);border-radius:4px;aspect-ratio:1;display:grid;place-items:center}
.ben .center svg{width:70%;color:#1f8a5b}

/* 2 Presse */
.press{padding-block:28px}
.press .wrap{display:flex;flex-direction:column;align-items:center;gap:14px}
.press .row{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:12px 28px}
.press .vu{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);font-weight:700}
.press .logo-slot{width:110px;height:36px;border:1px dashed var(--line);border-radius:3px;display:grid;place-items:center;font-size:11px;color:var(--muted)}
.press p{font-size:13px;color:var(--muted);text-align:center;max-width:60ch}

/* 4 Sans / Avec */
.ba{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center}
.ba>*{min-width:0}
.ba figure{margin:0;display:flex;flex-direction:column;gap:10px;text-align:center}
.ba .img{aspect-ratio:4/5;border-radius:4px;border:1px solid var(--line);display:grid;place-items:center;position:relative;overflow:hidden}
.ba .before{background:linear-gradient(180deg,var(--surface),var(--bg))}
.ba .after{background:radial-gradient(circle at 50% 35%,#3a5a50,#0e1c18 70%)}
.ba .after svg{width:46%;color:#8b1e2b}
.ba .neck{width:46%;aspect-ratio:1;border-radius:50% 50% 0 0;border:2px solid var(--line);border-bottom:0}
.ba figcaption b{display:block;font-family:var(--display);font-weight:400;font-size:20px}
.ba figcaption span{color:var(--muted);font-size:14px}
.ba .sep{width:44px;height:44px;border-radius:50%;background:var(--surface);border:1px solid var(--line);display:grid;place-items:center;color:var(--accent)}
.ba .sep svg{width:20px;height:20px}
@media (max-width:600px){.ba{grid-template-columns:1fr 1fr;gap:12px}.ba .sep{display:none}}

/* Geschenk */
.gift-sec{background:var(--surface)}
.gifts{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.gift{border:1px solid var(--line);border-radius:4px;background:var(--bg);padding:18px;display:flex;flex-direction:column;gap:10px}
.gift .heart{width:26px;height:24px;clip-path:path("M13 24 C13 24 0 15 0 7.5 C0 3 3 0 6.5 0 C9.5 0 11.6 1.9 13 4.4 C14.4 1.9 16.5 0 19.5 0 C23 0 26 3 26 7.5 C26 15 13 24 13 24Z")}
.gift p{color:var(--muted);font-size:15px}
.perks{display:flex;justify-content:center;gap:16px;margin-top:24px}
.perk{display:flex;gap:12px;align-items:flex-start}
.perk b{display:block}
.perk span{color:var(--muted);font-size:14px}
@media (max-width:860px){.gifts{grid-template-columns:repeat(2,1fr)}.perks{grid-template-columns:1fr}}
@media (max-width:440px){.gifts{grid-template-columns:1fr}}

/* Fotos */
.lifestyle img,.ba .img img,.step .vis img,.ben .center img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ben .center{position:relative;overflow:hidden}
.step .vis img.contain{object-fit:contain;background:#fff}
.step .vis{aspect-ratio:3/4!important}
.main{background:#fff!important;overflow:hidden}
.main img{width:100%;height:100%;object-fit:contain}
.main img.cover{object-fit:cover}
.thumbs{grid-template-columns:repeat(6,1fr)!important}
.gnote{font-size:12px;color:var(--muted)}
.thumbs button{aspect-ratio:1;border:1.5px solid var(--line);border-radius:4px;background:#fff;padding:0;overflow:hidden;cursor:pointer}
.thumbs button[aria-pressed="true"]{border-color:var(--accent)}
.thumbs img{width:100%;height:100%;object-fit:cover;display:block}
.m img{width:56px;height:56px;object-fit:contain;background:#fff;border-radius:3px}
.gift-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:28px}
.gift-row figure{margin:0;display:flex;flex-direction:column;gap:6px}
.gift-img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:4px;display:block}
.gift-img.portrait{object-position:center 30%}
.gift-row figcaption{font-size:12px;color:var(--muted)}
@media (max-width:600px){.gift-row{grid-template-columns:1fr}}

.stock{display:flex;flex-direction:column;gap:6px;font-size:14px}
.stock .top{display:flex;justify-content:space-between;gap:8px}
.stock b{color:var(--red)}
.stock span{color:var(--red);font-weight:700}
.stock .fillbar{background:var(--red)!important}
@keyframes pulse{0%,100%{transform:scale(1);box-shadow:0 4px 14px color-mix(in srgb,var(--act) 40%,transparent)}50%{transform:scale(1.03);box-shadow:0 0 0 8px color-mix(in srgb,var(--act) 25%,transparent)}}
@keyframes pulseopt{0%,100%{transform:scale(1);box-shadow:0 0 0 0 color-mix(in srgb,var(--act) 0%,transparent)}50%{transform:scale(1.02);box-shadow:0 0 0 6px color-mix(in srgb,var(--act) 30%,transparent)}}
@media (prefers-reduced-motion:no-preference){.cta{animation:pulse 1.4s ease-in-out infinite}}
.offer{border:1.5px solid var(--line);border-radius:4px;background:var(--surface);position:relative}
.obadge{position:absolute;top:-11px;right:12px;background:var(--red);color:#fff;font-size:11px;font-weight:700;letter-spacing:.06em;padding:3px 8px;border-radius:3px;text-transform:uppercase}
.osave{display:block;font-size:12px;font-weight:700;color:var(--red)}
.offer:has(input:checked){border-color:var(--accent)}
.offer .opt{border:0!important;background:none}
.offer-body{padding:0 14px 14px;display:flex;flex-direction:column;gap:8px}
.offer:not(:has(input:checked)) .offer-body{display:none}
.offer-body .lg{margin:0;font-size:13px;color:var(--muted)}
.stock .track{height:6px;border-radius:3px;background:var(--line);overflow:hidden}
.stock .fillbar{height:100%;width:var(--level,25%);background:var(--act)}
.bul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:15px}
.bul li{display:flex;gap:8px}
.bul li::before{content:"✓";color:var(--accent);font-weight:700;flex:none}
.pinfo details{padding-block:12px}
.pinfo summary{font-size:15px}
.pinfo p{font-size:14px}

.life{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.life figure{margin:0;display:flex;flex-direction:column;gap:8px}
.life img{width:100%;aspect-ratio:3/4;object-fit:cover;object-position:center 30%;border-radius:4px;display:block}
.life figcaption{font-size:14px;color:var(--muted)}
.launch{margin-top:24px;background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:20px;display:flex;flex-direction:column;gap:6px}
.launch b{font-family:var(--display);font-weight:400;font-size:20px}
@media (max-width:860px){.life{grid-template-columns:1fr 1fr}}
@media (max-width:440px){.life{grid-template-columns:1fr}}

.tp-slot{border:1px dashed var(--line);border-radius:4px;padding:12px;text-align:center;display:flex;flex-direction:column;gap:4px;font-size:14px}
.tp-slot small{color:var(--muted);font-size:12px}
.bsel-list{display:flex;flex-direction:column;gap:8px}
.bsel{display:flex;align-items:center;gap:10px}
.bsel img{width:44px;height:44px;flex:none;object-fit:contain;background:#fff;border-radius:4px}
.bsel select{flex:1;min-width:0;font:inherit;font-size:16px;padding:11px 12px;border:1.5px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);cursor:pointer}
.bsel select:focus-visible{border-color:var(--accent)}

.tp-head{text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:24px}
.tp-head h2{color:var(--accent)}
.tp-sum{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;font-size:20px}
.tp-sum b{font-size:28px;font-weight:400;font-family:var(--body)}
.tp-stars{display:inline-flex;gap:3px}
.tp-stars i{width:28px;height:28px;background:#00b67a;color:#fff;display:grid;place-items:center;font-style:normal;font-size:18px;line-height:1}
.tp-stars.sm i{width:22px;height:22px;font-size:14px}
.tp-count{color:var(--muted);font-size:15px}
.tp-row{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 12px;-webkit-overflow-scrolling:touch}
.tp-card{flex:0 0 min(320px,82%);scroll-snap-align:center;background:var(--surface);border:1.5px solid var(--accent);border-radius:12px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center}
.tp-av{width:64px;height:64px;border-radius:50%;background:var(--bg);display:grid;place-items:center;font-family:var(--display);font-size:24px;color:var(--accent)}
.tp-ver{display:flex;align-items:center;gap:8px;font-size:14px}
.tp-card h3{color:var(--accent);font-family:var(--body);font-weight:700;font-size:18px}
.tp-card p{font-size:15px}
.tp-foot{width:100%;display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:10px;margin-top:auto;font-size:14px}
.tp-foot b{color:var(--accent)}
.tp-foot span{color:var(--muted)}

/* Bewertungen */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.rev{background:var(--surface);border:1px dashed var(--line);border-radius:4px;padding:18px;display:flex;flex-direction:column;gap:10px}
.rev .photo{aspect-ratio:4/3;background:var(--bg);border-radius:3px;display:grid;place-items:center;color:var(--muted);font-size:13px}
.stars{color:var(--line);letter-spacing:2px}
.rev p{color:var(--muted);font-size:14px}

/* 6 Produkt */
.prod{display:grid;grid-template-columns:1.05fr 1fr;gap:40px;align-items:start}
.prod>*{min-width:0}
.gal{display:flex;flex-direction:column;gap:10px}
.main{background:radial-gradient(circle at 50% 40%,var(--surface),var(--bg) 75%);border:1px solid var(--line);border-radius:4px;aspect-ratio:1;max-width:100%;display:grid;place-items:center;position:relative}
.main svg{width:72%}
.main .tag{position:absolute;left:14px;bottom:12px;font-size:13px;color:var(--muted)}
.thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.thumbs div{aspect-ratio:1;border:1px dashed var(--line);border-radius:4px;background:var(--surface);display:grid;place-items:center;text-align:center;font-size:11px;color:var(--muted);padding:4px}
.buy{display:flex;flex-direction:column;gap:18px}
.price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;font-variant-numeric:tabular-nums}
.price b{font-size:32px;font-family:var(--body);font-weight:700;letter-spacing:-.01em}
.price s{color:var(--muted)}
.save{background:var(--act);color:var(--act-ink);font-size:12px;font-weight:700;padding:3px 8px;border-radius:2px;letter-spacing:.05em}
.rating{display:flex;gap:8px;align-items:center;font-size:14px;color:var(--muted);text-decoration:none;margin-top:-8px}.rating span:first-child{color:#00b67a;letter-spacing:2px}
.reason{font-size:14px;color:var(--muted);margin-top:-10px}
fieldset{border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;min-width:0}
legend,.lg{font-weight:700;font-size:15px;margin-bottom:8px;padding:0}
.opt{display:flex;gap:12px;align-items:center;border:1.5px solid var(--line);background:var(--surface);padding:12px 14px;border-radius:4px;cursor:pointer}
.opt:has(input:checked){border-color:var(--accent)}
.opt input{accent-color:var(--accent);width:18px;height:18px;margin:0}
.opt span{flex:1}
.opt em{font-style:normal;font-size:12px;font-weight:700;color:var(--accent)}
.opt strong{font-variant-numeric:tabular-nums}
.stones{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
.stone{border:1.5px solid var(--line);background:var(--surface);border-radius:4px;padding:6px 2px;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;color:var(--ink);font:inherit;font-size:11px}
.heart{display:block;width:18px;height:16px;clip-path:path("M9 16 C9 16 0 10 0 5 C0 2 2 0 4.5 0 C6.5 0 8 1.3 9 3 C10 1.3 11.5 0 13.5 0 C16 0 18 2 18 5 C18 10 9 16 9 16Z")}
.stone[aria-pressed="true"]{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.picked{font-size:14px;color:var(--muted);margin-top:6px}
.urg{font-size:14px;font-weight:700;color:var(--red);display:flex;gap:8px;align-items:center}
.urg::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;background:var(--red)}
.cta{background:var(--act);color:var(--act-ink);border:0;box-shadow:0 4px 14px color-mix(in srgb,var(--act) 40%,transparent);border-radius:4px;padding:18px;font:inherit;font-weight:700;font-size:18px;cursor:pointer;letter-spacing:.02em;width:100%}
.cta:hover{filter:brightness(1.08)}
.note{font-size:14px;padding:10px 12px;border-radius:4px;background:var(--flag);color:var(--flag-ink)}
.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.badges div{border:1px solid var(--line);border-radius:4px;padding:10px 8px;text-align:center;font-size:13px;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:4px}
.badges svg{width:22px;height:22px;color:var(--accent)}
.badges b{color:var(--ink);font-size:13px}

/* 7 Anwendung */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.step{background:var(--surface);border:1px solid var(--line);border-radius:4px;overflow:hidden}
.step .vis{aspect-ratio:4/3;background:var(--bg);display:grid;place-items:center;position:relative}
.step .vis svg{width:40%}
.step .txt{padding:16px;display:flex;flex-direction:column;gap:6px}
.step .n{font-family:var(--display);font-size:14px;color:var(--muted)}
.step p{color:var(--muted);font-size:15px}
.months{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-top:28px}
.m{background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:10px;display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center}
.m .heart{width:22px;height:20px;clip-path:path("M11 20 C11 20 0 12.5 0 6.2 C0 2.5 2.5 0 5.5 0 C8 0 9.8 1.6 11 3.7 C12.2 1.6 14 0 16.5 0 C19.5 0 22 2.5 22 6.2 C22 12.5 11 20 11 20Z")}
.m b{font-size:13px}
.m span{font-size:12px;color:var(--muted)}

/* 8 Galerie */
.wall{background:var(--surface);border:1px dashed var(--line);border-radius:4px;padding:28px;display:flex;flex-direction:column;gap:16px}
.wall .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.wall .grid div{aspect-ratio:1;background:var(--bg);border-radius:3px}
.wall p{color:var(--muted);font-size:14px}

/* 9 FAQ */
details{border-bottom:1px solid var(--line);padding-block:14px}
summary{cursor:pointer;font-weight:700}
details p{margin-top:8px;color:var(--muted);max-width:65ch}

/* 10 Kontakt */
.contact{max-width:640px}
.contact form{display:grid;grid-template-columns:1fr 1fr;gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:20px}
.contact label{display:flex;flex-direction:column;gap:4px;font-size:14px;font-weight:700}
.contact .full{grid-column:1/-1}
.contact input,.contact textarea{font:inherit;font-weight:400;border:1px solid var(--line);border-radius:3px;padding:10px;background:var(--bg);color:var(--ink);width:100%}
.contact textarea{min-height:110px;resize:vertical}
.send{background:var(--surface);color:var(--accent);border:1.5px solid var(--accent);border-radius:4px;padding:12px;font:inherit;font-weight:700;cursor:pointer}

/* 11 Fusszeile */
footer{background:var(--deep);color:var(--deep-ink);padding-block:36px;font-size:14px}
footer .wrap{display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between}
footer nav{display:flex;flex-wrap:wrap;gap:8px 20px}
footer a{color:inherit}
footer .muted{color:color-mix(in srgb,var(--deep-ink) 70%,transparent)}

:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media (max-width:860px){
  .hero .wrap,.prod{grid-template-columns:1fr}
  .ben{grid-template-columns:1fr}.ben .center{max-width:320px;margin:0 auto;width:100%;order:-1}
